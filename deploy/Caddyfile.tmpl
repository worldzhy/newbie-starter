# Caddy configuration template for the production stack.
#
# Placeholders __SITE_DOMAIN__ and __ACME_EMAIL__ are substituted by
# scripts/render-env.sh (values come from Secrets Manager). The rendered file
# is mounted read-only into the caddy container as /etc/caddy/Caddyfile.
#
# ROUTING CONSTRAINT — keep in sync with backend route layout (ADR-012):
# A module whose manifest declares `publicNamespace: true` claims the public
# URL space /<module-key>/* on the site domain; `newbie modules install` renders one
# pass-through `handle /<module-key>/*` block per claim between the
# @@newbie-modules markers below (ADR-008 D4 — never hand-edit the marker
# block). Those backend-native paths are proxied WITHOUT stripping /api.
# All other /api/* paths are backend controllers without a global prefix, so
# /api is stripped there — this mirrors the Next.js dev rewrite
# /api/:path* -> 127.0.0.1:3000/:path*. Any new backend-native route outside
# /api must arrive via its module's publicNamespace declaration.

{
	email __ACME_EMAIL__
}

__SITE_DOMAIN__ {
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

# @@newbie-modules-start
# @@newbie-modules-end

	# Remaining backend API: strip the /api prefix.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:3000
	}

	# Everything else is the Next.js frontend.
	handle {
		reverse_proxy frontend:3001
	}
}
