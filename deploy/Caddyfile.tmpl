# Caddy configuration template for the production stack.
#
# Placeholders __SITE_DOMAIN__ and __ACME_EMAIL__ are substituted by
# scripts/render-env.sh (values come from Secrets Manager). The rendered file
# is mounted read-only into the caddy container as /etc/caddy/Caddyfile.
#
# ROUTING (ADR-012, revised by ADR-034):
# Every backend route lives under /api/*. Caddy strips that prefix and proxies
# to the backend, which registers controllers without a global prefix — this
# mirrors the Next.js dev rewrite /api/:path* -> 127.0.0.1:3000/:path*.
# Modules no longer claim a public URL namespace (`publicNamespace` was dropped
# in ADR-034), so there is no per-module handle block and no generated region
# in this file: module routes arrive through the single /api/* handler below.
#
# The file is framework-owned and byte-identical across projects; `newbie
# template update` overwrites it whole. Propose changes in newbie-starter.

{
	email __ACME_EMAIL__
}

__SITE_DOMAIN__ {
	encode zstd gzip

	# Baseline security headers on every response (HTML document + API).
	# The CSP keeps script-src/style-src at 'unsafe-inline' because Next.js
	# bootstrap and the theme bootstrap script are inline; tightening to a
	# nonce-based CSP is tracked separately. connect-src allows any https
	# endpoint so beacons (web-monitor) and same-origin /api keep working.
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https: wss:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	handle /healthz {
		respond "ok" 200
	}

	# Backend API: strip the /api prefix.
	handle /api/* {
		uri strip_prefix /api
		reverse_proxy backend:3000
	}

	# Everything else is the Next.js frontend on hosts that ship a UI.
	# UI-less hosts run without the "ui" profile, so an unconditional proxy here
	# would answer 502 for every non-API path; render-env.sh swaps this line for
	# a 404 when the merged compose model has no frontend service (ADR-008 D1).
	handle {
		__FRONTEND_FALLBACK__
	}
}
