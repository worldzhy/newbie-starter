{
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "assets": [
      {
        "include": "modules/*/templates/**/*",
        "outDir": "dist"
      },
      {
        "include": "modules/*/clickhouse/migrations/*.sql",
        "outDir": "dist"
      },
      {
        "include": "application/*/clickhouse/migrations/*.sql",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
