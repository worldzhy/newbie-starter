{
  "name": "newbie-basic-template",
  "version": "0.1.0",
  "description": "newbie backend project template (basic)",
  "author": "worldzhy",
  "private": true,
  "license": "MIT",
  "prettier": "@devbie/style-guide/prettier",
  "scripts": {
    "build": "nest build",
    "check:template": "newbie update-template --check --template-path .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "newbie": "newbie",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/src/main.js",
    "test": "find src -name '*.test.ts' -print0 | xargs -0 -r node --import tsx --test"
  },
  "dependencies": {
    "@devbie/newbie": "^1.5.0",
    "@nestjs/axios": "^12.0.1",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.2.0",
    "@prisma/client": "^7.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.2.1",
    "pg": "^8.17.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@devbie/newbie-cli": "*",
    "@devbie/style-guide": "^1.3.1",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/schematics": "^12.0.7",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.16.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.9",
    "prisma": "^7.2.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
