# -------------------------------------------------------------------------------- #
# This file is managed by the newbie template.                                     #
# Framework-provided defaults ship with @devbie/newbie (see framework config).     #
# -------------------------------------------------------------------------------- #
# ENVIRONMENT: 'production' or 'development'
# SERVER_SERIAL_NUMBER: Related to cronjob
# --------------------------------------------------------------------------------

# Framework-managed block (ADR-009): `newbie update-template` rewrites it in
# place. Host-specific variables belong outside the markers.
# @@newbie-framework-start
ENVIRONMENT=development
PORT=3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# LOG_LEVEL: comma-separated Nest log levels; defaults to log,warn,error
# LOG_LEVEL=
# APP_VERSION: optional explicit version label; falls back to package.json version
# APP_VERSION=

# Built-in reporters (optional); each endpoint/token pair is env-gated and stays
# a no-op until both variables are set.
# Module-hub self-registration (full snapshot on boot, ping every 60s)
# MODULE_HUB_ENDPOINT=
# MODULE_HUB_TOKEN=
# Installation heartbeat
# HEARTBEAT_ENDPOINT=
# HEARTBEAT_TOKEN=
# Dependency health snapshots (posted every 30s)
# HEALTH_ENDPOINT=
# HEALTH_TOKEN=
# Backend request monitoring (interceptor + middleware)
# BACKEND_MONITOR_ENDPOINT=
# BACKEND_MONITOR_TOKEN=
# @@newbie-framework-end

# --------------------------------------------------------------------------------
# Host variables: everything outside the framework block belongs to the
# application itself and is never touched by `newbie update-template`.
APP_NAME=Newbie
APP_FRONTEND_URL=http://localhost:3001
PRISMA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/newbie
SERVER_SERIAL_NUMBER=1

# Variables of enabled newbie modules are generated between these markers.
# Do not edit this block manually; run 'newbie install' to regenerate it.
# @@newbie-modules-start
# @@newbie-modules-end
