#!/usr/bin/env bash
# Lints (fixable only) and formats staged files inside a throwaway Node
# container, then restages them. Each step runs this repo's own eslint flat
# config (from eslint.config.*) and prettier config (from package.json
# "prettier"). Finally, when a module-owned path is staged, it runs the
# local-only module source drift check (ADR-078). Fails closed: unfixable lint
# errors, formatter failures, or detected drift block the commit instead of
# letting debt into history. The drift check degrades to a warning (never
# blocks) when the CLI or registry is unavailable; CI's `modules apply --check`
# is the authoritative full gate.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# --- Pre-flight ---------------------------------------------------------

if [ ! -f node_modules/eslint/bin/eslint.js ]; then
  echo "pre-commit: eslint is missing (run npm install); commit blocked" >&2
  exit 1
fi

if [ ! -f node_modules/prettier/bin/prettier.cjs ]; then
  echo "pre-commit: prettier is missing (run npm install); commit blocked" >&2
  exit 1
fi

# --- Collect staged files (whole-file staging only) ----------------------
# Two NUL-delimited lists are written to temp files so we can safely pass
# paths containing spaces through docker, and avoid "set -e" being tripped
# by eslint's exit code on unfixable errors.

list_file=$(mktemp)
all_list=$(mktemp)
lint_list=$(mktemp)
trap 'rm -f "$list_file" "$all_list" "$lint_list"' EXIT

git diff --cached --name-only --diff-filter=ACMR -z > "$list_file"

# --- Module drift trigger (ADR-078) -------------------------------------
# Run the local-only gate only when a module-owned path is staged, so unrelated
# commits pay nothing. Scanned from the full staged list (not just lint/format
# files) so a binary or non-format change under src/modules is still caught.
drift_trigger=
while IFS= read -r -d '' path; do
  case "$path" in
    src/modules/*|newbie-modules.json|newbie-modules.lock.json)
      drift_trigger=1
      break
      ;;
  esac
done < "$list_file"

set --
while IFS= read -r -d '' path; do
  case "$path" in
    *.cjs|*.css|*.js|*.json|*.jsx|*.md|*.mdx|*.mjs|*.scss|*.ts|*.tsx|*.yml|*.yaml)
      if ! git diff --quiet -- "$path"; then
        echo "pre-commit: $path has unstaged changes; stage the whole file first" >&2
        exit 1
      fi
      case "$path" in
        *.cjs|*.js|*.jsx|*.mjs|*.ts|*.tsx)
          printf '%s\0' "$path" >> "$lint_list"
          printf '%s\0' "$path" >> "$all_list"
          ;;
        *)
          printf '%s\0' "$path" >> "$all_list"
          ;;
      esac
      ;;
  esac
done < "$list_file"

if [ ! -s "$all_list" ] && [ -z "$drift_trigger" ]; then
  exit 0
fi

# --- Lint (--fix, repo eslint flat config) -------------------------------
# set +e so we can capture eslint's exit code before restaging; the global
# set -e would otherwise abort at the run when unfixable errors exist.
#
# The execution environment differs across developers, so we probe Docker
# availability rather than guessing "inside vs outside a container":
#   - macOS host:     no local Node; Docker Desktop provides node:24-alpine
#   - dev container:  Node 24 installed; no Docker CLI/socket
# docker present -> run inside the pinned node:24-alpine image
# docker absent  -> run with the local Node toolchain (the repo cannot build
#                   without it, so it must exist whenever we reach this point)

if [ -s "$lint_list" ]; then
  set +e
  if command -v docker >/dev/null 2>&1; then
    docker run --rm --network none \
      -v "$repo_root":/workspace -w /workspace \
      -v "$lint_list":/tmp/lint_list:ro \
      node:24-alpine \
      sh -c 'cat /tmp/lint_list | xargs -0 node node_modules/eslint/bin/eslint.js --fix'
  else
    cat "$lint_list" | xargs -0 node node_modules/eslint/bin/eslint.js --fix
  fi
  lint_exit=$?
  set -e
  xargs -0 < "$lint_list" git add --
  if [ $lint_exit -ne 0 ]; then
    echo "pre-commit: lint found unfixable errors; commit blocked" >&2
    exit 1
  fi
fi

# --- Format (repo prettier config) ---------------------------------------
# Same docker-or-local selection as the lint step above. Skipped when no
# format/lint-relevant files are staged; a module-drift-only commit still
# reaches the drift gate below.

if [ -s "$all_list" ]; then
if command -v docker >/dev/null 2>&1; then
  docker run --rm --network none \
    -v "$repo_root":/workspace -w /workspace \
    -v "$all_list":/tmp/all_list:ro \
    node:24-alpine \
    sh -c '
      set -e
      spec=$(node -p "const p = require(\"./package.json\"); typeof p.prettier === \"string\" ? p.prettier : \"\"")
      if [ -n "$spec" ]; then
        node -e "require.resolve(process.argv[1])" "$spec"
      fi
      cat /tmp/all_list | xargs -0 node node_modules/prettier/bin/prettier.cjs --write
    '
else
  spec=$(node -p "const p = require('./package.json'); typeof p.prettier === 'string' ? p.prettier : ''")
  if [ -n "$spec" ]; then
    node -e "require.resolve(process.argv[1])" "$spec"
  fi
  cat "$all_list" | xargs -0 node node_modules/prettier/bin/prettier.cjs --write
fi || {
  echo "pre-commit: formatter failed; commit blocked" >&2
  exit 1
}

  xargs -0 < "$all_list" git add --
fi

# --- Module source drift (ADR-078) --------------------------------------
# Local-only, offline check: installed copies under src/modules/<key> must
# match their provenance lock. Runs only when a module-owned path is staged
# (drift_trigger above). Exit code contract: 0 clean, 2 drift found, anything
# else is a tooling/availability error. We block ONLY on 2; any other non-zero
# exit warns and skips so the gate never blocks on a missing CLI or registry.
# CI's `newbie modules apply --check` is the authoritative full gate (it also
# proves lock-tampered, which needs a registry checkout + git).
if [ -n "$drift_trigger" ]; then
  if [ ! -x node_modules/.bin/newbie ]; then
    echo "pre-commit: newbie CLI unavailable (run npm install); skipping module drift check (CI still enforces it)" >&2
  else
    set +e
    if command -v docker >/dev/null 2>&1; then
      docker run --rm --network none \
        -v "$repo_root":/workspace -w /workspace \
        node:24-alpine \
        node node_modules/.bin/newbie modules drift
    else
      node node_modules/.bin/newbie modules drift
    fi
    drift_exit=$?
    set -e
    if [ "$drift_exit" -eq 2 ]; then
      echo "pre-commit: module source drift detected; commit blocked (restore with 'newbie modules apply' or adopt with 'newbie modules update')" >&2
      exit 1
    elif [ "$drift_exit" -ne 0 ]; then
      echo "pre-commit: 'newbie modules drift' could not run (exit $drift_exit); skipping module drift check (CI still enforces it)" >&2
    fi
  fi
fi